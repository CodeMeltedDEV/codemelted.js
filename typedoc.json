{
  "name": "codemelted.js Project",
  "alwaysCreateEntryPointModule": true,
  "excludeExternals": true,
  "excludeProtected": true,
  "excludePrivate": true,
  "disableSources": true,
  "darkHighlightTheme": "dark-plus",
  "readme": "README.md",
  "hideGenerator": true,
  "entryPoints": [
    "./codemelted.js",
  ],
  "out": "docs",
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "powershell",
    "tsx",
    "typescript",
    "rust",
    "yaml"
  ],
  "ignoredHighlightLanguages": ["mermaid"],
  "projectDocuments": [
    "documents/domain-use-cases/index.md",
    "documents/software-engineering/index.md",
    "documents/change-log.md",
    "documents/cli.md",
    "documents/module-test.md",
    "documents/codemelted-rs.md"
  ],
  "favicon": "https://codemelted.com/favicon.png",
  "plugin": ["./assets/js/typedoc-plugin-og.js"],
  "$schema": "https://typedoc.org",
  "customDescription": "The codemelted.js Project aims to give software engineers the ability to deliver on this full stack engineering premise.",
  "customImage": "https://codemelted.com/assets/images/logo-codemelted-js.png",
  "customTwitter": "@CodeMeltedDEV"
}